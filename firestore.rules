rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each signed-in user can only read/write their own passport document,
    // keyed by their Firebase Auth uid. No one can read or write anyone else's.
    match /passports/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
